---
import { Image, Picture } from 'astro:assets';
import signature from '../assets/emma-signature-clean-transparent.png';
import laptop from '../assets/laptop-hair-tidy.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import DbcheckLogo from '../assets/dbcheck-logo.svg';
import FonecheckLogo from '../assets/fonecheck-logo-light.svg';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import runcheckLogo from '../../runcheck-logo.svg?raw';
---

<BaseLayout>
  <script is:inline>
    document.documentElement.classList.add('is-home-motion-booting');
    document.addEventListener(
      'DOMContentLoaded',
      () => document.documentElement.classList.remove('is-home-motion-booting'),
      { once: true },
    );
  </script>

  <SiteHeader />

  <section class="hero" aria-labelledby="hero-heading">
    <h1 id="hero-heading" class="hero-heading">Hi, I'm <span class="hero-name"><span class="hero-name-print">Emma.</span><span class="hero-signature" aria-hidden="true"><Image src={signature} alt="" format="png" width={600} loading="eager" /></span></span></h1>
    <div class="hero-laptop">
      <Picture
        src={laptop}
        formats={['webp']}
        fallbackFormat="png"
        widths={[480, 768, 1080, laptop.width]}
        sizes="(max-width: 760px) calc(100vw - 2.5rem), 70vw"
        quality="high"
        priority
        alt="A laptop with Emma Hotakainen on screen and the words: Probably working on the details."
      />
    </div>
    <a class="hero-scroll-link" href="#about" aria-label="Continue to the introduction">
      <svg width="24" height="32" viewBox="0 0 24 32" fill="none" aria-hidden="true">
        <path d="M12 2v27M4 21l8 8 8-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </section>

  <section id="about" class="home-about" aria-label="About Emma">
    <p>Finnvek is just the name I put on the things I build. I make Android apps because I like turning ideas into things that actually work.</p>
    <p>I design, build and test them myself, and tend to keep working on them until the little details feel right.</p>
  </section>

  <hr id="apps" class="section-divider" data-section-line />

  <section class="product product--mirror" data-product data-first-product>
    <div class="section-label" data-product-line>In the works</div>
    <div class="product-content">
      <a href="https://knittoolsapp.com" class="product-lockup" data-product-lockup aria-label="KnitTools — knittoolsapp.com">
        <img src="/images/knittools.webp" alt="" width="500" height="500" loading="lazy" decoding="async" data-product-logo data-logo-roll data-logo-stamp />
        <h2 class="product-name product-name--knittools">KnitTools</h2>
      </a>

      <div class="product-text">
        <p data-product-line>KnitTools is a pocket companion for knitters and crocheters. It counts your rows, keeps your patterns one tap away, and your yarn, notes, and progress photos quietly in order. In eleven languages, for Android.</p>

        <form class="notify" method="post" data-notify-form data-product-line>
          <label class="visually-hidden" for="notify-email">Email address</label>
          <label class="visually-hidden" for="notify-website">Leave this field empty</label>
          <input
            class="visually-hidden"
            id="notify-website"
            name="website"
            type="text"
            tabindex="-1"
            autocomplete="off"
            disabled
          />
          <input id="notify-email" name="email" type="email" placeholder="email address" autocomplete="email" required disabled />
          <button type="submit" disabled>Notify me at launch</button>
        </form>
        <p class="notify-error" data-notify-error role="alert" aria-live="polite" hidden></p>

        <a href="https://knittoolsapp.com" class="product-link" data-product-line>knittoolsapp.com</a>
      </div>
    </div>
  </section>

  <section class="product" data-product>
    <div class="section-label" aria-hidden="true"></div>
    <div class="product-content">
      <a href="https://runcheckapp.com" class="product-lockup" data-product-lockup aria-label="runcheck — runcheckapp.com">
        <span
          class="product-logo product-logo--runcheck"
          aria-hidden="true"
          data-product-logo
          data-logo-runcheck
          set:html={runcheckLogo}
        />
        <h2 class="product-name product-name--runcheck">runcheck</h2>
      </a>

      <div class="product-text">
        <p data-product-line>runcheck shows your phone's real condition. It checks battery, network, thermals, and storage, and turns the raw numbers into one clear health score. It warns you before small problems become annoying ones. For Android.</p>

        <a href="https://runcheckapp.com" class="product-link" data-product-line>runcheckapp.com</a>
      </div>
    </div>
  </section>

  <section class="product product--mirror" data-product>
    <div class="section-label" aria-hidden="true"></div>
    <div class="product-content">
      <a href="https://dbcheck.app" class="product-lockup" data-product-lockup aria-label="dBcheck — dbcheck.app">
        <DbcheckLogo aria-hidden="true" focusable="false" data-product-logo data-logo-signal />
        <h2 class="product-name product-name--dbcheck">dB<em>check</em></h2>
      </a>

      <div class="product-text">
        <p data-product-line>dBcheck makes everyday sound easier to understand. It helps you follow noise exposure over time and compare personal hearing checks with your own baseline. For Android.</p>

        <a href="https://dbcheck.app" class="product-link" data-product-line>dbcheck.app</a>
      </div>
    </div>
  </section>

  <section class="product" data-product>
    <div class="section-label" aria-hidden="true"></div>
    <div class="product-content">
      <div class="product-lockup product-lockup--text">
        <h2 class="visually-hidden">fonecheck</h2>
        <FonecheckLogo class="product-logo--fonecheck" aria-hidden="true" focusable="false" />
      </div>

      <div class="product-text">
        <p data-product-line>fonecheck is a more comprehensive Android diagnostics app for checking and understanding what's happening on your device.</p>
      </div>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<script>
  import '../scripts/home-animations';
</script>
