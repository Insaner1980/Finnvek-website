---
interface Props {
  current?: 'about' | 'privacy';
}

const { current } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-inner">
    <a href="/" class="footer-brand" aria-label="Finnvek home" data-animated-footer-brand>
      <div class="footer-wordmark">FINNVEK</div>
      <div class="footer-tagline">built to last</div>
    </a>
    <div class="footer-meta">
      <a class="site-link" href="/about/" aria-current={current === 'about' ? 'page' : undefined}>About</a>
      <a class="site-link" href="mailto:contact@finnvek.com">Contact</a>
      <a class="site-link" href="/privacy" aria-current={current === 'privacy' ? 'page' : undefined}>Privacy Policy</a>
      <span>&copy; 2026</span>
    </div>
  </div>
</footer>
